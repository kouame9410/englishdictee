# Copiez ce fichier en .env et adaptez : il est chargé automatiquement par config/settings.py.
DEBUG=1
SECRET_KEY=changez-moi
# PostgreSQL local (laisser vide pour utiliser SQLite en développement)
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/dictee
# Services externes (Gemini API : génération de textes, explications et TTS)
GEMINI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_API_KEY=
SCORE_FORM_WEIGHT=0.10
